<!-- $Id: gfile-view.tmpl 1492 2011-04-13 01:15:07Z jam $ -->
<div class="gfile">
<h1>title: {$title|escape:"html"|wpprop}</h1>
<h2>posted on {$dateposted} by {$authorname} (modified {$lastmodified} by {$lastmodifiedbyname}) in the
{if $sigid == NULL}
 <a href="/sig/browse/">top sig</a>
{else}
 <a href="/sig/browse/{$sigid}">{$signame} sig</a>
{/if}
</h2>
{$body|escape:"html"|wpprop}
{if $action.delete || $action.edit}
<div class="footer">
<ul>
{if $action.edit}<li><a href="/gfile/edit/{$id}">edit</a></li>{/if}
{if $action.delete}<li><a href="/gfile/delete/{$id}">delete</a></li>{/if}
</ul>
</div>
{/if}
</div>
