# php_flag register_globals off

RewriteEngine On
RewriteBase /
RewriteOptions Inherit


RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !/.well-known [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^about[/]?$ /about.php [last,qsappend]

#RewriteRule ^moneyday[/]?$ /moneyday.php [last]

RewriteRule ^sitenewsarchive[/]?$ /sitenewsarchive.php [last]

RewriteRule ^login[/]?$ /engine/login.php [last]
RewriteRule ^logout[/]?$ /engine/logout.php [last]
RewriteRule ^join[/]?$ /engine/join.php [last]

<RequireAll>
    Require all granted
</RequireAll>
