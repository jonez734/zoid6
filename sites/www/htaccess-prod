#
# Zoid Technologies Website Rewrite Rules
# Enables clean URLs and proper routing for dynamic pages
# @since 20260401 (modernized with empyre patterns)
#

RewriteEngine On
RewriteBase /
RewriteOptions Inherit

# Enforce HTTPS for all requests except .well-known (for SSL verification)
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !/.well-known [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Allow direct access to static files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route clean URLs to appropriate handlers
# Uncomment rules as needed to enable specific routes

# RewriteRule ^about[/]?$ about.php [last]
# RewriteRule ^sitenewsarchive[/]?$ sitenewsarchive.php [last]

# Engine routes
# RewriteRule ^login[/]?$ /engine/login.php [last]
# RewriteRule ^logout[/]?$ /engine/logout.php [last]
# RewriteRule ^join[/]?$ /engine/join.php [last]

# Require access control
<RequireAll>
    Require all granted
</RequireAll>
