<ul class="inlinelist nobullets breadcrumbs" itemscope itemtype="http://data-vocabulary.org/Breadcrumb">
 {if count($breadcrumbs) > 0}
	{foreach $breadcrumbs as $b}
		<li itemprop="child" itemscope itemtype="http://data-vocabulary.org/Breadcrumb">
		{if $b@last == false}
			{teos path=$b.labelpath itemprop=true} <i class="fas fa-angle-double-right"></i>
		{else}
			{if $linklast === true}
				{teos path=$b.labelpath itemprop=true}
			{else}
				{$b.title}
			{/if}
		{/if}
		</li>
    {/foreach}
 {else}
   <li>teos</li>
 {/if}
</ul>
