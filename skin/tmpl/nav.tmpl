{$choices = $data.choices|default:null}
<div class="blurb nav">
<div class="header"><h1>choices</h1></div>
<div class="body">
<ul class="inlinelist commadelimited">
{foreach from=$choices item=m}
{$class = $m.class|default:""}
{$title = $m.title|default:"NEEDTITLE"}
{$desc = $m.desc|default:""}
{$url = $m.url}
{$name = $m.name}
{if ($currentsite == $name and $currentpage == "index") or ($currentpage == $name)}
<li class="currentsite"><i class="{$class}"></i> {$title|escape|wpprop}</li>
{else}
<li><i class="{$class}"></i> <a href="{$url}" title="{$desc|escape|wpprop}">{$title|escape|wpprop}</a></li>
{/if}
{/foreach}
<li><a href="https://bbsengine.org/">bbsengine.org</a></li>
</ul>
</div> {* body *}
</div> {* blurb nav *}
{* amazonsearch.tmpl *}
