[Unit]
Description=zoid6 BBS Engine Daemon (bed with zoid6 config and router)
Documentation=https://bbsengine.org/
After=network.target postgresql.service oidentd.service
Wants=postgresql.service
Requires=oidentd.service
# Cap any unclassified crash loop at 10 attempts per 5 minutes so the
# operator notices the failure (unit enters 'failed' state) instead
# of the daemon quietly retrying forever.
StartLimitIntervalSec=300s
StartLimitBurst=10

[Service]
Type=simple
User=zoid6
Group=zoid6
# The startup log and its rotated backups are created 0640 (group zoid6 can read, others cannot).
UMask=0027
WorkingDirectory=/home/zoid6

# Run zoid6's own entry point (zoid6d -> zoid6.main:main). It resolves the zoid6 config (the packaged
# zoid6.json, which carries the services block the router needs) and the zoid6 router, then starts bed.
# Running bed directly skipped that resolution and started the generic daemon.
# The daemon connects to PostgreSQL as bed_zoid6, which identd maps from this OS user; the database flags
# are passed through to bed. No password and no environment file.
ExecStart=@VENV_DIR@/bin/zoid6d \
  --databasename zoid6 \
  --databaseuser bed_zoid6

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s

# bed exits 2 on permanent bind failures (EADDRINUSE/EACCES) when
# restart_on_bind_failure=false, and exits 3 when a transient FS /
# network error prevents loading the explicit config file with
# autorestart off (see bed.config.ConfigIORecoverableError). Do not
# loop the unit on either case.
RestartPreventExitStatus=2 3

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zoid6

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The venv lives under /home/zoid6, so the service must be able to read /home.
# ReadWritePaths below still lets it write its own home.
ProtectHome=read-only
ReadWritePaths=/var/log/zoid6 /home/zoid6

[Install]
WantedBy=multi-user.target
