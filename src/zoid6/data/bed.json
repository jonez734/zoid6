{
  "bed": {
    "autorestart": true,
    "restart_delay": 5,
    "max_restarts": 10
  },
  "debug": false,
  "services": {
    "auth": {
      "enabled": true,
      "modulepath": "auth.api.handler",
      "description": "Authentication service (login, logout, session management)"
    },
    "member": {
      "enabled": true,
      "modulepath": "member.api.handler",
      "description": "Member service (profile, tier, referrals)"
    },
    "bank": {
      "enabled": true,
      "modulepath": "bbsengine6.bank.api.handler",
      "description": "Banking service (balance, transfers, history)"
    },
    "channel": {
      "enabled": true,
      "modulepath": "channel.api.handler",
      "description": "Channel service (pub/sub messaging, channels)"
    },
    "casino": {
      "enabled": true,
      "modulepath": "casino.api.handler",
      "description": "Casino games (blackjack, poker, etc.)",
      "games": ["blackjack", "poker", "yahtzee"],
      "table_service": {
        "list_tables": true,
        "create_table": true,
        "join_table": true,
        "leave_table": true,
        "watch_table": true
      },
      "game_service": {
        "hit": true,
        "stand": true,
        "double": true,
        "split": true,
        "surrender": true
      },
      "bet_service": true,
      "chat_service": {
        "table_chat": true,
        "global_chat": true,
        "emote": true
      }
    },
    "postoffice": {
      "enabled": true,
      "modulepath": "postoffice.api.handler",
      "description": "Postoffice service (IMAP mail polling and notifications)",
      "poll_interval": 30,
      "mailboxes": []
    },
    "empyre": {
      "enabled": false,
      "modulepath": "empyre.api.handler",
      "description": "Empyre world building game (not yet implemented)"
    },
    "murdermotel": {
      "enabled": false,
      "modulepath": "murdermotel.api.handler",
      "description": "Murder Motel game (not yet implemented)"
    },
    "mistermcfeely": {
      "enabled": false,
      "modulepath": "mistermcfeely.api.handler",
      "description": "Post office package (not yet implemented)"
    }
  },
  "bind": {
    "host": "localhost",
    "port": 8765
  },
  "database": {
    "name": "zoid6",
    "host": "localhost",
    "port": 5432
  }
}
